/* ╔══════════════════════════════════════════════════════════════╗ */
/* ║  vibeOS Rofi - macOS Spotlight-style launcher              ║ */
/* ╚══════════════════════════════════════════════════════════════╝ */

configuration {
    show-icons:        true;
    icon-theme:        "Papirus-Dark";
    display-drun:      "";
    display-run:       "";
    display-window:    "";
    drun-display-format: "{name}";
    hover-select:      true;
    me-select-entry:   "";
    me-accept-entry:   "MousePrimary";
    window-format:     "{w} · {c} · {t}";
}

* {
    font:              "Inter 13";
    bg:                rgba(17, 17, 27, 0.85);
    bg-alt:            rgba(30, 30, 46, 0.9);
    fg:                #cdd6f4;
    fg-alt:            #a6adc8;
    accent:            #89b4fa;
    urgent:            #f38ba8;
    border-col:        rgba(69, 71, 90, 0.6);
    selected:          rgba(137, 180, 250, 0.2);
    active:            rgba(166, 227, 161, 0.2);
}

window {
    transparency:      "real";
    width:             600px;
    location:          center;
    anchor:            center;
    border:            1px solid;
    border-color:      @border-col;
    border-radius:     16px;
    background-color:  @bg;
    padding:           0;
}

mainbox {
    background-color:  transparent;
    children:          [ inputbar, listview ];
    padding:           0;
}

inputbar {
    background-color:  transparent;
    children:          [ prompt, entry ];
    padding:           16px 20px;
    border:            0 0 1px 0;
    border-color:      @border-col;
}

prompt {
    background-color:  transparent;
    text-color:        @accent;
    font:              "JetBrainsMono Nerd Font 16";
    padding:           0 12px 0 4px;
    vertical-align:    0.5;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "Search apps, files, settings...";
    placeholder-color: @fg-alt;
    padding:           4px 0;
    font:              "Inter 14";
}

listview {
    background-color:  transparent;
    columns:           1;
    lines:             7;
    padding:           8px 8px;
    spacing:           4px;
    fixed-height:      false;
    dynamic:           true;
    scrollbar:         false;
}

element {
    background-color:  transparent;
    text-color:        @fg;
    padding:           10px 16px;
    border-radius:     10px;
    spacing:           12px;
}

element selected.normal {
    background-color:  @selected;
    text-color:        @accent;
}

element selected.active {
    background-color:  @active;
    text-color:        @fg;
}

element selected.urgent {
    background-color:  @urgent;
    text-color:        @bg;
}

element-icon {
    size:              24px;
    background-color:  transparent;
}

element-text {
    background-color:  transparent;
    text-color:        inherit;
    vertical-align:    0.5;
}
